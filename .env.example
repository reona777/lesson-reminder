# Salesforce 認証
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# GAS Webhook（LINE送信・ID取得エンドポイント）
GAS_URL=
# GAS側の doGet / doPost を守る合言葉。GASのスクリプトプロパティ ROSTER_TOKEN と同じ値にする
ROSTER_TOKEN=

# Slack Webhook
SLACK_WEBHOOK=
SLACK_TEACHER_WEBHOOK=

# Google サービスアカウントJSON（文字列）
CREDENTIALS_JSON=

# 保護者LINE通知設定（任意）
# 保護者へのLINE通知が不要な場合は空欄のまま
PARENT_LINE_SPREADSHEET_ID=
PARENT_LINE_SHEET_NAME=line
# カンマ区切りで生徒名を指定（例: 山田太郎,佐藤花子）
PARENT_NOTIFY_TARGET_NAMES=

# コース名の判定表（任意）
# `正規表現:前倒し時間` のカンマ区切り。前から順に評価し最初に一致したものを使う。
# 前倒し時間は「実際の開始がレコードの時刻よりN時間早い」コースを補正するためのもの。
# 表示するコース名もこの表から決まる。未設定なら補正なし・名称をそのまま表示。
COURSE_RULES=標準コースL:2,標準コースS:1
# 体験回の判定（任意）。体験回には前倒しを適用しない
TRIAL_PATTERN=体験
TRIAL_EXCEPT_PATTERN=体験[2２②]

# リマインド対象外にする授業名のキーワード（任意・カンマ区切り）
SKIP_LESSON_KEYWORDS=未定,研修

# 問い合わせ同期スクリプト用（main.py）
PORTAL_EMAIL=
PORTAL_PASSWORD=
LOGIN_URL=
SPREADSHEET_ID=
INQUIRY_SHEET_NAME=問合
SCHOOL_NAME=
INQUIRY_SOURCE_LABEL=
